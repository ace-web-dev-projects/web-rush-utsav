      "code": "<!doctype html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"UTF-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n    <title>Web Rush</title>\n    <style>\n      body {\n        margin: 0;\n        font-family: Arial, sans-serif;\n        background: #f6f2fd;\n        color: #1f2a44;\n      }\n      header {\n        background: #d9ccf5;\n        text-align: center;\n        padding: 40px 16px;\n      }\n      header h1 {\n        margin: 0;\n        font-size: 3rem;\n        letter-spacing: 6px;\n      }\n      header p {\n        margin: 8px 0 0;\n      }\n      main {\n        padding: 20px 16px;\n      }\n      .card {\n        background: #ffffff;\n        color: #f6f2fd;\n        max-width: 560px;\n        margin: 20px auto;\n        padding: 24px;\n        border-radius: 16px;\n        box-shadow: 0 4px 12px rgba(31, 42, 68, 0.15);\n        text-align: center;\n      }\n      .details {\n        display: flex;\n        justify-content: center;\n        gap: 12px;\n        list-style: none;\n        padding: 0;\n      }\n      .details li {\n        flex: 1;\n        padding: 12px;\n        border-radius: 12px;\n        background: #ffd9c7;\n      }\n      .details li:nth-child(2) {\n        background: #c8f0dc;\n      }\n      .details li:nth-child(3) {\n        background: #e6dcfa;\n      }\n      .details strong {\n        display: block;\n        margin-bottom: 4px;\n      }\n      button {\n        background: #f6f2fd;\n        color: #ffffff;\n        border: none;\n        padding: 14px 32px;\n        font-size: 1rem;\n        border-radius: 30px;\n        cursor: pointer;\n      }\n      button:hover {\n        background: #e8896a;\n      }\n      #message {\n        background: #c8f0dc;\n        padding: 12px;\n        border-radius: 10px;\n        font-weight: bold;\n      }\n      #message:empty {\n        display: none;\n      }\n      footer {\n        text-align: center;\n        padding: 20px;\n        font-size: 0.9rem;\n      }\n    </style>\n  </head>\n  <body>\n    <section class=\"card\">\n      <h2>Join the Rush</h2>\n      <button id=\"registerBtn\">Register Now</button>\n      <p id=\"message\"></p>\n    </section>\n\n    <header>\n      <h1>WEB RUSH</h1>\n      <p>Code fast. Build bright. Win big.</p>\n      <ul class=\"details\">\n        <li><strong>Date</strong>11 Oct 2026</li>\n        <li><strong>Time</strong>10:00 AM</li>\n        <li><strong>Venue</strong>LTC 301</li>\n      </ul>\n    </header>\n\n    <main>\n      <section class=\"card\">\n        <h2>Event Information</h2>\n        <p>\n          A friendly coding contest where you race to build and fix small\n          websites. No experience needed, just curiosity!\n        </p>\n      </section>\n    </main>\n\n    <footer>\n      <p>Web Rush | ACE</p>\n    </footer>\n\n    <script>\n      const button = document.getElementById(\"registerBtn\");\n      const message = document.getElementById(\"message\");\n\n      button.addEventListener(\"clik\", function () {\n        const text = \"You are registered for Web Rush! See you there.\";\n        message.textContent = \"text\";\n      });\n    </script>\n  </body>\n</html>\n"
