// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider                = "prisma-client"
  output                  = "../src/generated/prisma"
  generatedFileExtension  = "ts"
  importFileExtension     = "ts"
}

datasource db {
  provider = "postgresql"
}

enum EventStatus {
  NOT_STARTED
  ACTIVE
  ENDED
}

model Team {
  id           Int      @id @default(autoincrement())
  name         String
  teamCode     String   @unique
  passwordHash String?
  points       Float    @default(0)
  createdAt    DateTime @default(now())
  round1PuzzleProgress Round1PuzzleProgress[]
  round2QuestionProgress Round2QuestionProgress[]
}

model Round2QuestionProgress {
  id            Int       @id @default(autoincrement())
  teamId        Int
  questionId    String
  answer        String
  attempts      Int       @default(0)
  solvedAt      DateTime?
  pointsAwarded Float     @default(0)
  team          Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([teamId, questionId])
}

model Round1PuzzleProgress {
  id            Int       @id @default(autoincrement())
  teamId        Int
  puzzleId      String
  word          String
  guesses       Json      @default("[]")
  attempts      Int       @default(0)
  solvedAt      DateTime?
  pointsAwarded Int       @default(0)
  team          Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([teamId, puzzleId])
}

model Admin {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  password String
  createdAt    DateTime @default(now())
}

model EventState {
  id                 Int         @id @default(1)
  currentRound       Int?
  status             EventStatus @default(NOT_STARTED)
  startedAt          DateTime?
  endedAt            DateTime?
  round6BuzzedTeamId Int?
  round6BuzzedName   String?
  updatedAt          DateTime    @updatedAt
}


