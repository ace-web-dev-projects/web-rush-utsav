# PostgreSQL connection string used by Prisma and the PostgreSQL adapter.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Set a long, random secret (at least 32 characters) before starting the server.
JWT_SECRET="replace-with-a-long-random-secret"

# Exact, case-sensitive Round 5 password used to award partial points.
ROUND_5_ANSWER="replace-with-the-round-5-answer"

# Optional: defaults to 3000.
PORT=3000
